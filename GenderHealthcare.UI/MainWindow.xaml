<Window x:Class="GenderHealthcare.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GenderHealthcare.UI.Views"
        xmlns:converters="clr-namespace:GenderHealthcare.UI.Converters"
        Title="Gender Healthcare Management System" 
        MinHeight="800" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF4A90E2">
            <Grid>
                <TextBlock Text="GENDER HEALTHCARE MANAGEMENT SYSTEM" FontSize="20" FontWeight="Bold" FontFamily="Arial" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <Button Content="Đăng xuất" Background="Transparent" Foreground="White" FontFamily="Arial" BorderThickness="1" BorderBrush="White" Padding="15,5" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Margin="10" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Quản lý người dùng">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Button Content="Thêm" FontFamily="Arial" Click="BtnAddUser_Click" Margin="5"/>
                        <Button Content="Cập nhật" FontFamily="Arial" Click="BtnUpdateUser_Click" Margin="5"/>
                        <Button Content="Xóa" FontFamily="Arial" Click="BtnDeleteUser_Click" Margin="5"/>
                    </StackPanel>
                    <DataGrid x:Name="UserGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" FontFamily="Arial" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Tên đăng nhập" FontFamily="Arial" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="Họ" FontFamily="Arial" Binding="{Binding FirstName}" />
                            <DataGridTextColumn Header="Tên" FontFamily="Arial" Binding="{Binding LastName}" />
                            <DataGridTextColumn Header="Ngày sinh" FontFamily="Arial" Binding="{Binding DateOfBirth}" />
                            <DataGridTextColumn Header="Giới tính" FontFamily="Arial" Binding="{Binding Gender}" />
                            <DataGridTextColumn Header="Số điện thoại" FontFamily="Arial" Binding="{Binding Phone}" />
                            <DataGridTextColumn Header="Trạng thái" FontFamily="Arial" Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Quản lý vai trò">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Button Content="Thêm" FontFamily="Arial" Click="BtnAddRole_Click" Margin="5"/>
                        <Button Content="Cập nhật" FontFamily="Arial" Click="BtnUpdateRole_Click" Margin="5"/>
                        <Button Content="Xóa" FontFamily="Arial" Click="BtnDeleteRole_Click" Margin="5"/>
                    </StackPanel>
                    <DataGrid x:Name="RoleGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" FontFamily="Arial" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Tên vai trò" FontFamily="Arial" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Mô tả" FontFamily="Arial" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Trạng thái" FontFamily="Arial" Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Quản lý lịch hẹn">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Button Content="Thêm" FontFamily="Arial" Click="BtnAddAppointment_Click" Margin="5"/>
                        <Button Content="Cập nhật" FontFamily="Arial" Click="BtnUpdateAppointment_Click" Margin="5"/>
                        <Button Content="Xóa" FontFamily="Arial" Click="BtnDeleteAppointment_Click" Margin="5"/>
                    </StackPanel>
                    <DataGrid x:Name="AppointmentGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User ID" FontFamily="Arial" Binding="{Binding UserId}" />
                            <DataGridTextColumn Header="Consultant ID" FontFamily="Arial" Binding="{Binding ConsultantId}" />
                            <DataGridTextColumn Header="Ngày hẹn" FontFamily="Arial" Binding="{Binding AppointmentDate}" />
                            <DataGridTextColumn Header="Trạng thái" FontFamily="Arial" Binding="{Binding AppointmentStatus}" />
                            <DataGridTextColumn Header="Địa điểm" FontFamily="Arial" Binding="{Binding AppointmentLocation}" />
                            <DataGridTextColumn Header="Giờ bắt đầu" FontFamily="Arial" Binding="{Binding StartTime}" />
                            <DataGridTextColumn Header="Giờ kết thúc" FontFamily="Arial" Binding="{Binding EndTime}" />
                            <DataGridTextColumn Header="Giá cố định" FontFamily="Arial" Binding="{Binding FixedPrice}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Quản lý hồ sơ cố vấn">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Button Content="Thêm" FontFamily="Arial" Click="BtnAddConsultantProfile_Click" Margin="5"/>
                        <Button Content="Cập nhật" FontFamily="Arial" Click="BtnUpdateConsultantProfile_Click" Margin="5"/>
                        <Button Content="Xóa" FontFamily="Arial" Click="BtnDeleteConsultantProfile_Click" Margin="5"/>
                    </StackPanel>
                    <DataGrid x:Name="ConsultantProfileGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Consultant ID" FontFamily="Arial" Binding="{Binding ConsultantId}" />
                            <DataGridTextColumn Header="Chuyên môn" FontFamily="Arial" Binding="{Binding Specialization}" />
                            <DataGridTextColumn Header="Trình độ" FontFamily="Arial" Binding="{Binding Qualification}" />
                            <DataGridTextColumn Header="Kinh nghiệm" FontFamily="Arial" Binding="{Binding Experience}" />
                            <DataGridTextColumn Header="Phí tư vấn" FontFamily="Arial" Binding="{Binding ConsultationFee}" />
                            <DataGridTextColumn Header="Trạng thái" FontFamily="Arial" Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Quản lý thanh toán">
                <local:PaymentManagementView/>
            </TabItem>
            <TabItem Header="Quản lý phản hồi">
                <local:FeedbackManagementView/>
            </TabItem>
            <TabItem Header="Theo dõi chu kỳ">
                <local:CycleTrackerView/>
            </TabItem>
            <TabItem Header="Quản lý Blog">
                <local:BlogWindow/>
            </TabItem>
            <TabItem Header="Quản lý dịch vụ xét nghiệm STD">
                <local:StdDiseaseManagementView/>
            </TabItem>
            <TabItem Header="Quản lý offer">
                <local:OfferManagementView/>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#FF4A90E2">
            <TextBlock Text="© 2025 Gender Healthcare System. All rights reserved." FontFamily="Arial" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
        </Border>
    </Grid>
</Window>