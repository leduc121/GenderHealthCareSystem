<Window x:Class="GenderHealthcare.UI.Views.BlogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Blog" Height="400" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Tiêu đề:" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Blog.Title}" Margin="5"/>

        <Label Content="Nội dung:" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Blog.Content}" AcceptsReturn="True" Height="100" Margin="5"/>

        <Label Content="Tác giả ID:" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Blog.AuthorId}" Margin="5" IsReadOnly="True"/>

        <Label Content="Ngày đăng:" Grid.Row="3" Grid.Column="0" Margin="5"/>
        <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding Blog.PublishedDate}" Margin="5"/>

        <Label Content="Trạng thái:" Grid.Row="4" Grid.Column="0" Margin="5"/>
        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Blog.Status}" Content="Kích hoạt" Margin="5"/>

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Lưu" Width="80" Margin="5" Click="Save_Click"/>
            <Button Content="Hủy" Width="80" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>