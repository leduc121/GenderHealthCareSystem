<UserControl x:Class="GenderHealthcare.UI.Views.BlogWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:GenderHealthcare.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="BlogWindow_OnLoaded">
    <UserControl.Resources>
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <TextBlock Text="Quản lý Blog" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Khai báo Blog -->
        <GroupBox Header="Khai báo Blog" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tiêu đề:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleTextBox" Text="{Binding Blog.Title, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nội dung:" VerticalAlignment="Top" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ContentTextBox" Text="{Binding Blog.Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Margin="5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày đăng:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Row="2" Grid.Column="1" x:Name="PublishedDatePicker" SelectedDate="{Binding Blog.PublishedDate, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                <Button Grid.Row="3" Grid.Column="1" x:Name="SaveButton" Content="Lưu" Width="100" HorizontalAlignment="Left" Margin="5" Click="SaveButton_Click"/>
            </Grid>
        </GroupBox>

        <TextBlock Text="Danh sách Blog" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
        <DataGrid x:Name="BlogGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Tác giả ID" Binding="{Binding AuthorId}" Width="*"/>
                <DataGridTextColumn Header="Ngày đăng" Binding="{Binding PublishedDate, StringFormat=dd/MM/yyyy}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Kích hoạt|Không kích hoạt'}" Width="*"/>
                <DataGridTemplateColumn Header="Hành động" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Xem chi tiết" Click="ViewDetails_Click" Tag="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>