<Window x:Class="GenderHealthcare.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Gender Healthcare System" 
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Background="#FF4A90E2">
        <Border Background="White" CornerRadius="10" Margin="50" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="GENDER HEALTHCARE SYSTEM" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF4A90E2" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="Hệ thống quản lý dịch vụ chăm sóc sức khỏe giới tính" FontSize="12" HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,30"/>
                <TextBlock Grid.Row="2" Text="Tên đăng nhập:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" x:Name="txtUsername" Height="35" Padding="10,5" FontSize="14" Margin="0,5,0,15"/>
                <TextBlock Grid.Row="4" Text="Mật khẩu:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="5" x:Name="txtPassword" Height="35" Padding="10,5" FontSize="14" Margin="0,5,0,20"/>
                <Button Grid.Row="6" x:Name="btnLogin" Content="Đăng nhập" Height="40" Width="200" Background="#FF4A90E2" Foreground="White" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Click="BtnLogin_Click" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="7" x:Name="lblMessage" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Grid.Row="8" x:Name="btnExit" Content="Thoát" Height="30" Width="150" Background="#FF6B9BD2" Foreground="White" Click="BtnExit_Click" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>