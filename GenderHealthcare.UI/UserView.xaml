<UserControl x:Class="GenderHealthcare.UI.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GenderHealthcare.UI.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <DockPanel>
        <!-- Nút Đăng xuất -->
        <Button Content="Đăng xuất"
                DockPanel.Dock="Top"
                HorizontalAlignment="Right"
                Margin="10"
                Padding="6,3"
                Click="LogoutButton_Click"/>

        <!-- Tab chính -->
        <TabControl x:Name="mainTabControl"
                    SelectionChanged="mainTabControl_SelectionChanged">
            <!-- Tab 1: Theo dõi chu kỳ -->
            <TabItem Header="Theo dõi chu kỳ">
                <local:CycleTrackerView />
            </TabItem>
            <!-- Tab 2: Đặt lịch hẹn -->
            <TabItem Header="Đặt lịch hẹn">
                <local:AppointmentBookingView x:Name="bookingView"/>
            </TabItem>
            <!-- Tab 3: Lịch hẹn của tôi -->
            <TabItem Header="Lịch hẹn của tôi" x:Name="tabAppointments">
                <local:UserAppointmentsView x:Name="appointmentsView"/>
            </TabItem>
            <!-- Tab 4: Gửi phản hồi -->
            <TabItem Header="Gửi phản hồi" x:Name="tabFeedback">
                <StackPanel Margin="10">
                    <TextBlock Text="Gửi phản hồi"
                             FontSize="18"
                             FontWeight="Bold"
                             Margin="0,0,0,10"/>
                    <GroupBox Header="Chọn cố vấn để phản hồi" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Dropdown chọn cố vấn (FullName) -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Cố vấn:" Margin="5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="cmbFeedbackConsultants"
                                      DisplayMemberPath="ConsultantName"
                                      SelectedValuePath="ConsultantId"
                                      Margin="5"/>
                            <!-- Điểm đánh giá -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Điểm đánh giá (1-5):" Margin="5"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     x:Name="txtRating"
                                     Margin="5"/>
                            <!-- Nội dung phản hồi -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Nội dung phản hồi:" Margin="5"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     x:Name="txtFeedback"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     Margin="5"
                                     AcceptsReturn="True"/>
                            <!-- Nút Gửi -->
                            <Button Grid.Row="3" Grid.Column="1"
                                    Content="Gửi"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Margin="5"
                                    Click="SubmitFeedback_Click"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <!-- Tab 5: Xét nghiệm STD -->
            <TabItem Header="Xét nghiệm STD" x:Name="tabStdTests">
                <local:StdDiseaseView x:Name="stdServiceView"/>
            </TabItem>
            <!-- Tab 6: Thông báo -->
            <TabItem Header="Thông báo" x:Name="tabNotifications">
                <local:UserNotificationsView x:Name="notificationsView"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>